{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run / Debug gameProject (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/gameProject/build/game_project.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/gameProject/build",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build gameProject"
        }
    ]
}
