{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build gameProject",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "cd /d \"${workspaceFolder}\\gameProject\" && cmake -B build -G \"MinGW Makefiles\" && cmake --build build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
